# ==============================================================================
# Creative Radar - Environment Configuration Template
# Copy this file to .env and fill in your values for local testing.
# In GitHub Actions, configure these as repository secrets (Settings > Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL: Google Gemini API Key (Free Tier)
# Used for intelligent 3-part summaries ("What happened", "Why it matters", "Next steps").
# If left blank, Creative Radar automatically falls back to clean extractive summaries.
# Get a free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional AI model override (defaults to gemini-2.5-flash; fallback gemini-1.5-flash)
AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Telegram Bot Credentials
# Used to send the daily briefing and urgent alerts to your phone/desktop Telegram.
# If left blank or if DRY_RUN=true, briefings are printed safely to logs.
# - Bot Token: Create a bot with @BotFather on Telegram (format: 123456789:ABCdefGhI...)
# - Chat ID: Message @userinfobot or your bot, or use your channel ID (e.g., 987654321 or -100...)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. PIPELINE SETTINGS
# ------------------------------------------------------------------------------
# Set to 'true' to simulate runs without publishing or sending real Telegram messages
DRY_RUN=false

# Enable Telegram delivery (disabled by default; website dashboard is the primary output).
# Set to 'true' and configure TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID to receive daily briefings.
ENABLE_TELEGRAM=false

# Environment: development or production
RADAR_ENV=development

# Relative or absolute path to store generated radar data and health metrics
DATA_DIR=data

# Maximum items to fetch per individual feed per run (prevents stale backlog floods)
MAX_ITEMS_PER_FEED=15

# Request timeout in seconds for HTTP feed fetching
REQUEST_TIMEOUT=15
